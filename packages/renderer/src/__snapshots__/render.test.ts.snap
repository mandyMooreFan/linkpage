<dt class="lp-day">Fri</dt><dd class="lp-times"><span>9:00 AM – 5:00 PM</span></dd>
<dt class="lp-day">Sat</dt><dd class="lp-times"><span>10:00 AM – 2:00 PM</span><span>5:00 PM – 9:00 PM</span></dd>
