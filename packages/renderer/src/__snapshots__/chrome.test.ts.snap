":root{color-scheme:dark;--lp-ground:#160f10;--lp-ink:#feecf0;--lp-ink-muted:#c9b8bc;--lp-surface:#231b1c;--lp-rule:#312427;--lp-brand:#c2185b;--lp-fill:#c2185b;--lp-fill-ink:#feecf0;--lp-accent:#2e7d32;--lp-accent-ink:#3d8c40;--lp-gutter:1.25rem;--lp-radius:0.75rem;--lp-font:system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;--lp-font-head:"Iowan Old Style", "Palatino Linotype", Palatino, "Book Antiqua", Georgia, "Times New Roman", serif;--lp-head-weight:600;--lp-head-track:0;--lp-line:1.5}
