":root{color-scheme:light;--lp-ground:#fdf7f8;--lp-ink:#281c1e;--lp-ink-muted:#524446;--lp-surface:#ffffff;--lp-rule:#e4d3d5;--lp-brand:#c2185b;--lp-fill:#c2185b;--lp-fill-ink:#fdf7f8;--lp-accent:#2e7d32;--lp-accent-ink:#2e7d32;--lp-gutter:1.25rem;--lp-radius:0.75rem;--lp-font:"Helvetica Neue", Helvetica, "Segoe UI", Roboto, system-ui, -apple-system, Arial, sans-serif;--lp-font-head:var(--lp-font);--lp-head-weight:700;--lp-head-track:-0.02em;--lp-line:1.45}
.lp-header{align-items:flex-start;padding-inline-start:0.875rem;border-inline-start:3px solid var(--lp-fill);text-align:start}
.lp-link{justify-content:flex-start}
.lp-panel{padding:0.125rem 0 0.125rem 0.875rem;border:0;border-inline-start:3px solid var(--lp-fill);border-radius:0;background:none}
.lp-social{justify-content:flex-start}"
`;
